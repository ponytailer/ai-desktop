# 阿里云 AI Gateway（APIG 2024-03-27）对接配置
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交。

# ---------- 鉴权（AK / SK）----------
ALIYUN_ACCESS_KEY_ID=your-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret

# ---------- 网关与配额规则 ----------
# AI Gateway 控制面域名（不同账号/环境可能不同，默认华东1公网接入点）
ALIYUN_APIG_HOST=apig.cn-hangzhou.aliyuncs.com
# 网关实例 ID（用于查询积分用量 GetGatewayQuotaRuleSubjectUsage）
ALIYUN_APIG_GATEWAY_ID=
# 配额规则 ID
ALIYUN_APIG_QUOTA_RULE_ID=
# 默认查询主体 subject（消费者 ID），不填则由「当前用户已分配密钥绑定的消费组」决定
ALIYUN_APIG_SUBJECT_ID=

# ---------- Mock 开关 ----------
# 1 = 强制走 mock 演示数据；0 或留空 = 仅当「未配置 AK/SK」时自动 mock
AIGW_USE_MOCK=1
